{
  "manifest_version": 3,
  "name": "Chrome Tab Remote",
  "version": "0.1.0",
  "key": "",
  "description": "Grant an agent revocable, origin-pinned, observe-only access to exactly one tab.",
  "permissions": [
    "activeTab",
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Chrome Tab Remote"
  }
}
