direction: down

title: |md
  **Chrome Web Store readiness gates**
|

decide: {
  label: "**1. Decide**"
  style.fill: "#fde8e8"
  name: "Confirm working name: AI Tab Grant"
  policy: "Privacy policy hosting"
  reviewer: "Reviewer helper + missing-helper UX"
}

prepare: {
  label: "**2. Prepare release system**"
  style.fill: "#e8f0fe"
  audit: "Green precommit + dependency audit"
  version: "Single version source"
  package: "Deterministic package + verifier"
  listing: "Permissions + privacy + assets"
}

h1: {
  label: "**3. H1 — Account + permanent item ID**"
  style.fill: "#fef7e0"
  account: "Publisher name + verified contact email"
  bootstrap: "Upload V_bootstrap (identity only)"
  key: "View Store public key + item ID"
}

final: {
  label: "**4. Final artifact gate**"
  style.fill: "#e6f4ea"
  pin: "Pin Store key + align host ID"
  version: "Build V_final > V_bootstrap"
  rehearse: "Lock + rehearse exact ZIP"
}

h2a: {
  label: "**5. H2a — Submit exact artifact**"
  style.fill: "#f3e8fd"
  upload: "Upload New Package: locked ZIP"
  verify: "Dashboard version = V_final"
  public: "Visibility = public"
  defer: "Submit deferred (auto-publish OFF)"
}

h2b: {
  label: "**6. H2b — Publish after approval**"
  style.fill: "#e8f0fe"
  staged: "Approved = staged, not public"
  expiry: "Record live expiry"
  publish: "Human verifies + clicks Publish"
  proof: "Verify public URL/version"
}

h3: {
  label: "**7. H3 — Verified Uploads**"
  style.fill: "#fef7e0"
  custody: "Custody + recovery tested"
  warning: "Read warning; treat as irreversible"
  optin: "Human-only opt-in"
}

decide -> prepare -> h1 -> final -> h2a -> h2b -> h3
