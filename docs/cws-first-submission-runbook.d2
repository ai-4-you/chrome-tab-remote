direction: down

title: |md
  **First submission — exact artifact to public release**
|

prep: {
  label: "**A. Release preparation**"
  style.fill: "#e8f0fe"
  rename: "Confirm name + rename"
  assets: "Icons + screenshots + promo"
  pkg: "Deterministic bootstrap/final packaging"
  helper: "Helper-unavailable UX + troubleshooting"
}

account: {
  label: "**B. H1 — Account + identity bootstrap**"
  style.fill: "#fef7e0"
  profile: "Publisher name + verified contact email"
  reg: "Strong auth, register, pay fee"
  bootstrap: "Upload V_bootstrap (not release)"
  key: "Package -> View public key"
}

final: {
  label: "**C. Build and lock final artifact**"
  style.fill: "#e6f4ea"
  pin: "Pin Store key + verify item ID"
  version: "Build V_final > V_bootstrap"
  host: "Regenerate native-host allowlist"
  rehearse: "Rehearse one locked ZIP + hash"
}

submit: {
  label: "**D. H2a — Exact upload + deferred submission**"
  style.fill: "#f3e8fd"
  upload: "Upload New Package: locked final ZIP"
  verify: "Dashboard version = V_final"
  listing: "Listing + privacy + reviewer packet"
  defer: "Submit for Review; disable auto-publish"
}

review: {
  label: "**E. Review**"
  style.fill: "#fde8e8"
  wait: "Plan: days to a few weeks"
  reject: "Reject -> fix, increment, rehearse, re-upload"
  approve: "Approve -> staged / ready to publish"
}

publish: {
  label: "**F. H2b — Manual publication**"
  style.fill: "#e8f0fe"
  expiry: "Record live expiry (up to 30 days today)"
  check: "Recheck version + listing"
  go: "Human clicks Publish"
  proof: "Verify public URL + version"
}

after: {
  label: "**G. H3 — Signed future updates**"
  style.fill: "#fef7e0"
  custody: "Test key custody + recovery"
  warning: "Read warning; treat opt-in irreversible"
  crx: "Human opts in; future uploads signed"
}

prep -> account -> final -> submit -> review -> publish -> after
review.reject -> final: "new higher version"
